# 请复制为 .env，并填入千问平台 API Key。不要把真实密钥提交到 Git。
QWEN_API_KEY=sk-your-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# json_object 兼容模型更多；确认模型支持严格 JSON Schema 后可改为 json_schema。
QWEN_RESPONSE_FORMAT=json_object
QWEN_TEMPERATURE=0.2
QWEN_MAX_TOKENS=8000
QWEN_TIMEOUT_SECONDS=120
QWEN_MAX_RETRIES=2

APP_NAME=Scalyn
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
