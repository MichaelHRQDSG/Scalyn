# Copy to .env and fill your API key. Do not commit real secrets.
QWEN_API_KEY=sk-your-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

QWEN_RESPONSE_FORMAT=json_object
QWEN_TEMPERATURE=0.2
QWEN_MAX_TOKENS=8000
QWEN_TIMEOUT_SECONDS=120
QWEN_MAX_RETRIES=2
# 0 = lookup by model name; set e.g. 131072 to override
QWEN_MAX_CONTEXT_TOKENS=0

APP_NAME=Scalyn
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]